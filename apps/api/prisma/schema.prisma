generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "./prisma"
  output       = "../src/generated/pothos-types.ts"
}

datasource db {
  provider = "postgresql"
}

model Suite {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  version   Int        @default(1)
  cases     TaskCase[]
  runs      Run[]
  createdAt DateTime   @default(now())
}

model TaskCase {
  id        String   @id @default(cuid())
  suite     Suite    @relation(fields: [suiteId], references: [id])
  suiteId   String
  externalId String
  prompt    String
  expected  Json?
  rubric    String?
  tags      String[]
   groundTruth Json?
  trajectories Trajectory[]
  @@unique([suiteId, externalId])
}

model Run {
  id         String   @id @default(cuid())
  suite      Suite    @relation(fields: [suiteId], references: [id])
  suiteId    String
  model      String
  config     Json
  status     RunStatus @default(QUEUED)
  totalCases Int      @default(0)
  doneCases  Int      @default(0)
  costUsd    Float    @default(0)
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  trajectories Trajectory[]
  calibrations Calibration[]
  @@index([suiteId, startedAt])
}

model Trajectory {
  id          String   @id @default(cuid())
  run         Run      @relation(fields: [runId], references: [id])
  runId       String
  taskCase    TaskCase @relation(fields: [taskCaseId], references: [id])
  taskCaseId  String
  status      TrajStatus @default(QUEUED)
  steps       Json     @default("[]")
  updatedAt DateTime @updatedAt
  finalOutput String   @default("")
  terminalState String?
  claimedAt DateTime?
  latencyMs   Int      @default(0)
  inputTokens Int      @default(0)
  outputTokens Int     @default(0)
  costUsd     Float    @default(0)
  attempt     Int      @default(0)
  error       String?
  scores      Score[]
  review      Review?
  @@unique([runId, taskCaseId])
  @@index([runId, status])
  @@index([status, updatedAt])
}

model Score {
  id           String   @id @default(cuid())
  trajectory   Trajectory @relation(fields: [trajectoryId], references: [id])
  trajectoryId String
  scorerKey    String
  scorerKind   String
  value        Float
  passed       Boolean
  confidence   Float
  rationale    String?
  costUsd      Float   @default(0)
  @@unique([trajectoryId, scorerKey])
  @@index([scorerKey, passed])
}

model Review {
  id           String   @id @default(cuid())
  trajectory   Trajectory @relation(fields: [trajectoryId], references: [id])
  trajectoryId String   @unique
  reason       ReviewReason
  humanPassed  Boolean?
  reviewer     String?
  note         String?
  blind Boolean @default(false)
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  @@index([humanPassed, createdAt])
}

model Calibration {
  id          String @id @default(cuid())
  run         Run    @relation(fields: [runId], references: [id])
  runId       String
  scorerKey   String
  n           Int
  agreement   Float
  kappa       Float
  falsePass   Int
  falseFail   Int
  computedAt  DateTime @default(now())
  @@unique([runId, scorerKey])
}

enum RunStatus { 
  QUEUED 
  RUNNING 
  COMPLETED 
  FAILED 
  }
enum TrajStatus { 
  QUEUED 
  RUNNING 
  SCORED 
  FAILED 
  }
enum ReviewReason { 

  LOW_CONFIDENCE 
  SCORER_DISAGREEMENT 
  SAMPLED 
  }