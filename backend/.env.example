# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Neon (serverless Postgres). Paste the connection string from the Neon console.
# The driver prefix must be postgresql+asyncpg:// (not plain postgresql://).
# sslmode= / channel_binding= params are stripped automatically â€” asyncpg rejects
# them as DSN keywords, so database.py translates them into connect_args.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb

# Local Postgres instead:
# DATABASE_URL=postgresql+asyncpg://evalgate:evalgate@localhost:5432/evalgate
# Zero-setup local file, no server required:
# DATABASE_URL=sqlite+aiosqlite:///./evalgate.db

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# Model whose outputs are being evaluated.
DEFAULT_MODEL=claude-haiku-4-5-20251001
# Model acting as the grading judge. Should be at least as capable as the
# model under test, otherwise the judge becomes the bottleneck on accuracy.
JUDGE_MODEL=claude-sonnet-5

# --- Gating thresholds ---
# Judge confidence below this routes the case to the human review queue
# instead of auto-deciding it.
DEFAULT_CONFIDENCE_THRESHOLD=0.75
# Score at or above this is a pass (applied only once confidence clears the bar).
PASS_THRESHOLD=0.7
