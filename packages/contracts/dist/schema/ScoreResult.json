{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "trajectoryId": {
      "type": "string"
    },
    "scorerKey": {
      "type": "string"
    },
    "scorerKind": {
      "type": "string",
      "enum": [
        "deterministic",
        "programmatic",
        "llm_judge"
      ]
    },
    "value": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "passed": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "costUsd": {
      "default": 0,
      "type": "number"
    },
    "latencyMs": {
      "default": 0,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "trajectoryId",
    "scorerKey",
    "scorerKind",
    "value",
    "passed",
    "confidence",
    "rationale"
  ]
}