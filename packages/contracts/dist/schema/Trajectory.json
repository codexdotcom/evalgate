{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskCaseId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "tool",
              "system"
            ]
          },
          "content": {
            "default": "",
            "type": "string"
          },
          "toolCalls": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "args": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "id",
                "name",
                "args"
              ]
            }
          },
          "toolResult": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "latencyMs": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "inputTokens": {
            "default": 0,
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "outputTokens": {
            "default": 0,
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "index",
          "role"
        ]
      }
    },
    "finalOutput": {
      "type": "string"
    },
    "terminalState": {
      "type": "string",
      "enum": [
        "completed",
        "max_steps",
        "error",
        "refused"
      ]
    }
  },
  "required": [
    "taskCaseId",
    "runId",
    "steps",
    "finalOutput",
    "terminalState"
  ]
}